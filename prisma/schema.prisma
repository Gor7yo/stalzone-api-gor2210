// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  stalzoneId Int    @unique
  uuid       String @unique
  login      String @unique

  steamId String? @map("steam_id")

  distributor    String?
  distributor_id String?

  /// Telegram, привязанный к аккаунту для алертов (один аккаунт - один Telegram)
  chatId       BigInt?   @unique @map("chat_id")
  /// Персонажи по всем регионам из EXBO /{region}/characters (ExboCharacter[])
  characters   Json?
  charactersAt DateTime? @map("characters_at")

  /// Pro действует до этого момента. Копируется на привязанный Telegram (alerts.watcher смотрит туда)
  proUntil    DateTime? @map("pro_until")
  /// Пробный Pro взят (один раз на аккаунт и на Telegram)
  trialUsedAt DateTime? @map("trial_used_at")
  /// Бан от админа; копируется на привязанный Telegram (бот молчит)
  bannedUntil DateTime? @map("banned_until")
  banReason   String?   @map("ban_reason")
  /// Последний визит (не чаще раза в 10 мин)
  lastSeenAt  DateTime? @map("last_seen_at")
  /// Код реферальной ссылки t.me/<бот>?start=ref_<код>; создаётся при первом запросе ссылки
  refCode     String?   @unique @map("ref_code")
  /// Не присылать в бот итоги месяца (кнопка «Не присылать итоги»)
  recapOff    Boolean   @default(false) @map("recap_off")

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  stalzoneAccount StalzoneAccount?
  subscriber      TelegramSubscriber? @relation(fields: [chatId], references: [chatId], onDelete: SetNull)
  sessions        AccountSession[]

  @@map("users")
}

/// Сессия сайта после входа через EXBO (в браузере - токен, в БД - sha256 от него)
model AccountSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_sessions")
}

/// День, когда аккаунт заходил (DAU/WAU в админке)
model AccountActivityDay {
  day    DateTime @db.Date
  userId String

  @@id([day, userId])
  @@map("account_activity_days")
}

/// Одноразовый state входа через EXBO
model ExboLinkState {
  /// sha256 от state - сам state знают только браузер и EXBO
  stateHash String   @id
  /// Вход из мини-приложения: этот Telegram привяжется к аккаунту
  chatId    BigInt?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("exbo_link_states")
}

model StalzoneAccount {
  id     String @id @default(uuid())
  userId String @unique

  accessToken  String
  refreshToken String
  expiresAt    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stalzone_accounts")
}

/// Клан из списка EXBO. Список целиком переписывает ClansService (раз в час) —
/// у EXBO нет поиска кланов и истории, ищем и считаем метрики по своей копии.
model Clan {
  id     String @id
  region String
  name   String
  tag    String
  leader String

  level            Int       @default(0)
  levelPoints      BigInt    @default(0)
  memberCount      Int       @default(0)
  alliance         String?
  registrationTime DateTime?
  description      String    @default("")
  /// Позиция в выдаче EXBO (с 1). Это НЕ рейтинг — порядок списка EXBO случайный;
  /// рейтинга кланов в API нет, сортируем сами по уровню и числу бойцов
  rank             Int       @default(0)
  /// Для поиска: без цветовых кодов, в нижнем регистре, ё → е
  tagKey           String    @default("")
  nameKey          String    @default("")
  leaderKey        String    @default("")
  /// tagKey + nameKey + leaderKey одной строкой — на ней триграммный индекс (см. миграцию clan_search)
  searchKey        String    @default("")
  syncedAt         DateTime  @default(now())
  /// Пропал из списка EXBO (распущен); null — живой. Через 90 дней строка удаляется
  goneAt           DateTime?

  @@index([region, rank])
  @@index([region, goneAt])
  @@index([region, level(sort: Desc), memberCount(sort: Desc)])
  @@index([searchKey(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("clans")
}

/// Игрок, за прогрессом которого следим: его профиль открывали на сайте.
/// Раз в сутки PlayersService обновляет тех, кого смотрели за последние 30 дней (фоновой квотой EXBO).
model TrackedCharacter {
  region       String
  uuid         String
  username     String
  /// ник в нижнем регистре, ё → е — поиск прогресса по нику
  usernameKey  String   @map("username_key")
  lastViewedAt DateTime @map("last_viewed_at")
  refreshedAt  DateTime @map("refreshed_at")

  @@id([region, uuid])
  @@index([region, usernameKey])
  @@index([lastViewedAt])
  @@map("tracked_characters")
}

/// Статистика игрока на конец дня (МСК): последний снимок дня перезаписывает предыдущий.
/// stats — { [id статы EXBO]: число }, только числовые (без дат). Храним 120 дней.
model CharacterSnapshot {
  region String
  uuid   String
  day    DateTime @db.Date
  at     DateTime
  stats  Json

  @@id([region, uuid, day])
  @@index([day])
  @@map("character_snapshots")
}

/// История клана для метрик (бойцы, уровень). Пишет ClansService при синхронизации раз в час —
/// только для нового клана и если изменились бойцы или уровень. Между снимками значения не менялись.
/// Почасовые точки старше 14 дней сжимаются до последней точки дня.
model ClanSnapshot {
  clanId      String
  at          DateTime
  region      String
  level       Int
  memberCount Int

  @@id([clanId, at])
  @@index([region, at])
  @@map("clan_snapshots")
}

// ---------- алерты в Telegram-боте ----------

/// Пользователь Telegram, который запустил бота или включил алерт в мини-приложении.
/// Кто заходил в какой день — для графика активных пользователей (DAU)
model ActivityDay {
  day    DateTime @db.Date
  chatId BigInt

  @@id([day, chatId])
  @@map("activity_days")
}

/// Журнал действий админа: выдача/снятие Pro, баны
model AdminLog {
  id        String   @id @default(uuid())
  adminId   BigInt
  /// Telegram цели (старые записи); новые - targetUserId
  targetId  BigInt?
  targetUserId String?
  /// pro_grant | pro_revoke | ban | unban
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_logs")
}

/// Обработанные платежи Tribute — вебхук повторяется, Pro выдаём один раз
model ProPayment {
  /// "product:<purchase_id>" или "sub:<subscription_id>:<expires_at>"
  id        String   @id
  chatId    BigInt
  /// Аккаунт, которому выдан Pro (null - Telegram ещё не привязан, Pro ждёт на чате)
  userId    String?
  event     String
  amount    Int?
  currency  String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@map("pro_payments")
}

model TelegramSubscriber {
  chatId    BigInt  @id
  firstName String?
  username  String?

  /// Регионы, о выбросах в которых присылать уведомление
  emissionRegions String[]  @default([])
  /// Радар рынка (Pro): регионы, о резких движениях цен в которых сообщать
  radarRegions    String[]  @default([]) @map("radar_regions")
  /// Пользователь заблокировал бота — не шлём, пока снова не нажмёт /start
  blocked         Boolean   @default(false)
  /// Pro действует до этого момента; null или в прошлом — бесплатная версия
  proUntil        DateTime?
  /// Когда взят пробный Pro (один раз на Telegram); null — ещё не брал
  trialUsedAt     DateTime?
  /// Бан от админа до этого момента (далёкое будущее — навсегда); null — нет
  bannedUntil     DateTime?
  banReason       String?
  /// Последний визит в мини-приложение / на сайт (обновляется не чаще раза в 10 мин)
  lastSeenAt      DateTime?
  /// Пришёл по реферальной ссылке этого аккаунта (User.id); засчитывается при привязке Telegram
  referredBy      String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  priceAlerts PriceAlert[]
  flipAlerts  FlipAlert[]
  webSessions WebSession[]
  exboUser    User?

  @@map("telegram_subscribers")
}

/// Приглашение по реферальной ссылке: один раз на приглашённый аккаунт.
model Referral {
  id        String   @id @default(uuid())
  inviterId String
  /// Приглашённый аккаунт — засчитывается один раз
  inviteeId String   @unique
  chatId    BigInt
  /// Пригласившему начислен день Pro (false — ждём часов в игре, упёрся в лимит за 30 дней или не дождались)
  rewarded  Boolean
  /// Когда начислен бонус — по нему считается лимит за 30 дней
  rewardedAt   DateTime?
  /// У друга меньше 5 часов в игре: до этой даты ждём, что наиграет (null — уже решено)
  pendingUntil DateTime?
  createdAt DateTime @default(now())

  @@index([inviterId, createdAt])
  @@index([pendingUntil])
  @@map("referrals")
}

/// Обращение в поддержку из бота. В группе поддержки у каждого - своя тема (topicId).
/// Отзыв о сервисе: один в неделю на Telegram, публикуется после модерации (сайт + канал).
model Review {
  id        Int       @id @default(autoincrement())
  chatId    BigInt
  userId    String
  /// Ник, который человек сам указал (проверяется при модерации)
  nick      String
  /// 1–5
  rating    Int
  text      String
  /// pending - ждёт модерации, published - опубликован, rejected - отклонён
  status    String    @default("pending")
  /// Пост в канале отзывов (REVIEWS_CHANNEL_ID), если опубликован туда
  channelMessageId Int?
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?

  @@index([status, createdAt])
  @@index([chatId, createdAt])
  @@map("reviews")
}

model SupportTicket {
  id       Int     @id @default(autoincrement())
  chatId   BigInt
  /// Аккаунт EXBO, если Telegram привязан (для карточки в группе)
  userId   String?
  /// question | payment | bug | idea
  category String
  /// open - ждёт ответа, answered - ответили, closed - закрыто
  status   String  @default("open")
  /// Тема в группе поддержки; null - группа не настроена или тему создать не удалось
  topicId  Int?
  /// Оценка после закрытия: 1 - помогли, -1 - нет; null - не оценили
  rating   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages SupportMessage[]

  @@index([chatId, status])
  @@index([topicId])
  @@map("support_tickets")
}

/// Сообщение в тикете - история переписки (текст и/или фото).
model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  fromAdmin Boolean
  text      String?
  /// file_id фото в Telegram
  photo     String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

/// «Сообщи, когда <предмет> на <регион> будет дешевле <maxPrice> за штуку».
model PriceAlert {
  id       String @id @default(uuid())
  chatId   BigInt
  region   String
  itemId   String
  itemName String

  /// Одно качество артефакта 0–5 (старые алерты; null — любое)
  quality   Int?
  /// Выбранные качества: [2, 3] = Особый или Редкий; пусто — смотрим на quality
  qualities Int[] @default([])
  /// Один уровень заточки 0–15 (старые алерты; null — любая)
  upgrade   Int?
  /// Выбранные уровни заточки: [1, 5] или [5, 6, 7…]; пусто — смотрим на upgrade
  upgrades  Int[] @default([])
  /// Ключевая характеристика модуля (marksman, sadist…); "" - любая
  variant   String @default("")
  /// Порог цены за штуку
  maxPrice  Int

  /// Последний лот, о котором уже сообщили — чтобы не слать одно и то же каждую минуту
  lastLotKey     String?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  subscriber TelegramSubscriber @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@index([region, itemId])
  @@index([chatId])
  @@map("price_alerts")
}

/// Флип-алерт: сообщать о новых выгодных лотах из ленты флиппера. Один на человека и регион.
model FlipAlert {
  id     String @id @default(uuid())
  chatId BigInt
  region String

  /// Прибыль после комиссии не меньше (₽, весь лот)
  minProfit     Int
  /// И не меньше стольких % от выкупа
  minPct        Int      @default(10)
  /// low | medium | high — минимальная надёжность оценки
  minConfidence String   @default("medium")
  /// Выкуп лота не дороже; 0 — любой
  maxBudget     Int      @default(0)
  /// Категории предметов (artefact, weapon, armor…); пусто — любые
  groups        String[] @default([])

  /// Ключи лотов, о которых уже сообщили (последние ~300) — не повторяемся
  sentKeys       String[]  @default([])
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  subscriber TelegramSubscriber @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@unique([chatId, region])
  @@map("flip_alerts")
}

/// Небольшое key-value хранилище состояния фоновых задач (например, последний выброс, о котором уже сообщили).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_state")
}

/// Одноразовый код привязки сайта к Telegram: сайт создаёт → бот подтверждает → сайт забирает сессию.
model TelegramLinkCode {
  /// sha256 от кода — сам код знает только браузер и ссылка t.me/<бот>?start=link_<код>
  codeHash  String   @id
  /// Аккаунт, к которому привязываем Telegram
  userId    String?
  /// Заполняется, когда пользователь подтвердил привязку в боте
  chatId    BigInt?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("telegram_link_codes")
}

/// Сессия сайта в браузере, привязанная к чату Telegram (для алертов вне мини-приложения).
model WebSession {
  id         String   @id @default(uuid())
  /// sha256 от токена; сам токен хранится только в браузере
  tokenHash  String   @unique
  chatId     BigInt
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  subscriber TelegramSubscriber @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@index([chatId])
  @@map("web_sessions")
}

// ---------- собственные данные аукциона (сборщик) ----------

/// Сделка на аукционе. Продажи не меняются — сборщик только дописывает новые.
model AuctionSale {
  id      BigInt   @id @default(autoincrement())
  region  String
  itemId  String
  time    DateTime
  /// Цена всей сделки (за amount штук)
  price   BigInt
  amount  Int
  /// Качество 0–5; -1 — у предмета нет качества (не null: в уникальном ключе Postgres NULL ≠ NULL)
  quality Int      @default(-1)
  /// Заточка 0–15 (+0, если в лоте поля не было)
  upgrade Int      @default(0)
  /// Ключевая характеристика модуля (definitionId атрибута type 2: marksman, sadist…); "" — нет
  variant String   @default("")

  /// Одинаковые сделки в одну секунду считаем одной: у EXBO нет id сделки
  @@unique([region, itemId, time, price, amount, quality, upgrade, variant], name: "sale_identity")
  @@index([region, itemId, time(sort: Desc)])
  @@map("auction_sales")
}

/// Лот на аукционе: снимок обновляется сборщиком; goneAt — когда лот пропал (купили или истёк).
model AuctionLot {
  id           BigInt    @id @default(autoincrement())
  region       String
  itemId       String
  startTime    DateTime
  endTime      DateTime
  amount       Int
  startPrice   BigInt
  currentPrice BigInt?
  buyoutPrice  BigInt
  /// -1 — без качества (см. AuctionSale.quality)
  quality      Int       @default(-1)
  upgrade      Int       @default(0)
  /// Ключевая характеристика модуля (см. AuctionSale.variant)
  variant      String    @default("")
  /// Все атрибуты модуля из EXBO (приставка, суффикс, ключевая; quality и statsRandom) - для процентов на сайте
  attributes   Json?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  goneAt       DateTime?

  /// У EXBO нет id лота — узнаём его по моменту выставления и параметрам
  @@unique([region, itemId, startTime, amount, startPrice, buyoutPrice, quality, upgrade, variant], name: "lot_identity")
  @@index([region, itemId, goneAt])
  @@map("auction_lots")
}

/// Торгуется ли предмет вообще: последняя продажа и лоты сейчас (MarketActivityService, раз в сутки по всему справочнику).
/// По ней рынок на сайте скрывает предметы, которых месяц не было на аукционе.
model MarketItemActivity {
  region     String
  itemId     String
  lastSaleAt DateTime?
  lotsTotal  Int       @default(0)
  checkedAt  DateTime

  @@id([region, itemId])
  @@index([checkedAt])
  @@map("market_item_activity")
}

/// Предмет, который сборщик держит свежим. Частота зависит от ликвидности и интереса пользователей.
model TrackedItem {
  region String
  itemId String
  /// seed — стартовый список, view — открывали на сайте, alert — стоит алерт
  source String @default("seed")

  /// Продаж в сутки (по накопленной истории) — от этого зависит частота
  salesPerDay Float     @default(0)
  /// Когда пользователь последний раз открывал предмет / пользовался алертом
  wantedAt    DateTime?

  nextLotsAt     DateTime  @default(now())
  nextSalesAt    DateTime  @default(now())
  /// Быстрая проверка новых лотов (сначала свежие): раз в freshEverySec; null — не проверяем
  freshEverySec  Int?
  nextFreshAt    DateTime  @default(now())
  /// Флипов (сделок заметно ниже медианы) за неделю — по нему раздаётся freshEverySec
  flipScore      Float     @default(0)
  lastLotsAt     DateTime?
  lastSalesAt    DateTime?
  /// Смещение догрузки старой истории (страницами по 200); null — догружено
  backfillOffset Int?      @default(0)
  /// С какого момента история продаж в БД полная (epoch — вся история EXBO); null — ещё догружается
  historyFrom    DateTime?
  /// Сколько лотов было на аукционе при последнем снимке (в снимке — не больше 200 самых дешёвых)
  lotsTotal      Int?
  failures       Int       @default(0)
  lastError      String?

  createdAt DateTime @default(now())

  @@id([region, itemId])
  @@index([nextLotsAt])
  @@index([nextSalesAt])
  @@index([nextFreshAt])
  @@map("tracked_items")
}
