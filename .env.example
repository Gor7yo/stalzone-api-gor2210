# База данных (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/stalzone

PORT=3001

# Приложение EXBO (client_credentials)
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=
STALZONE_OAUTH_URL=https://exbo.net
STALZONE_API_URL=https://eapi.stalzone.com
STALZONE_REDIRECT_URI=http://localhost:3001/auth/stalzone/callback

# Откуда разрешены запросы (через запятую)
CORS_PATHS=http://localhost:3000

# Ключ шифрования OAuth-токенов игроков в БД (32 байта, base64).
# Сгенерировать: openssl rand -base64 32
# Без него вход через EXBO отключён, остальной API работает.
TOKEN_ENCRYPTION_KEY=

# За nginx/Cloudflare: 1 — доверять одному прокси (нужно для лимита запросов по IP)
TRUST_PROXY=

# Telegram-бот для алертов (цена ниже порога, начался выброс). Токен — у @BotFather.
# Без него алерты отключены, остальной API работает.
TELEGRAM_BOT_TOKEN=
# Ссылка на мини-приложение (как NEXT_PUBLIC_TG_APP_URL во фронте) — для кнопок «Открыть» в уведомлениях
TELEGRAM_APP_URL=
# false — не принимать команды бота (если бота уже опрашивает другой процесс); уведомления всё равно отправляются
TELEGRAM_POLLING=
# false — меню бота обычным HTML вместо rich-сообщений (таблицы, картинки; Bot API 10.1+)
TELEGRAM_RICH=
# Адрес сайта: кнопки «Открыть» (мини-приложение) и картинки в меню бота. По умолчанию https://stalzone-info.ru
SITE_URL=
# Группа поддержки: супергруппа с темами, бот - админ с правом «Управление темами».
# Каждое обращение - отдельная тема, ответ в теме уходит пользователю. Пусто - обращения приходят ADMIN_CHAT_IDS в личку.
SUPPORT_CHAT_ID=
# false — выключить мониторинг (сообщения ADMIN_CHAT_IDS о поломках сборщика, EXBO, базы и сводка в 9:00 МСК)
MONITOR=

# Квота STALCRAFT API: токенов в минуту на приложение (аукцион стоит 2, остальное 1) и сколько
# из них сборщик обязан оставить запросам пользователей. По умолчанию 100 и 30%.
EXBO_TOKENS_PER_MIN=
EXBO_USER_RESERVE=

# Сборщик аукциона (свои лоты и история продаж в БД): регионы через запятую, false — выключить
COLLECTOR_REGIONS=ru
COLLECTOR_ENABLED=
# false — не обновлять список кланов (поиск, список, история для метрик; раз в час, ~80 запросов к EXBO на все регионы)
CLAN_SYNC_ENABLED=

# Служебные эндпоинты (/api/collector/status): заголовок X-Admin-Token: <ADMIN_TOKEN>.
# Пусто — открыты только при NODE_ENV != production. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
